#pragma profilepragma blendoperation(gl_FragColor, GL_FUNC_ADD, GL_ONE, GL_ONE_MINUS_SRC_ALPHA, GL_FUNC_ADD, GL_ONE, GL_ONE_MINUS_SRC_ALPHA)

precision lowp float;

uniform sampler2D Texture;

uniform float BlendIntensity;

varying mediump vec2 vTexCoord;


void main()
{
   
   vec2 color = texture2D(Texture, vTexCoord).ra;

   gl_FragColor.rgb = vec3 (1.0,0.0,0.0) *color.g *color.r * BlendIntensity;
   gl_FragColor.a = color.g * BlendIntensity;
}
